# EmailJS keys for the contact form (https://www.emailjs.com, free tier is fine).
# Without these the form falls back to opening the visitor's mail app.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# The guestbook and visitor bots. On Vercel, connect Upstash Redis (Storage tab) and it sets these.
# Without them the feature hides itself in production. Local development uses temporary memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Lets you delete a name from the board. Use a long random value and keep it private.
# VISITORS_ADMIN_KEY=
# Extra words to refuse in names, separated by commas.
# BLOCKED_NAMES=
